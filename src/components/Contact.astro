---
import { Icon } from 'astro-icon/components';
import SectionTitle from './SectionTitle.astro';
import { profile } from '../data/profile';

const linkedin = profile.socials.find((s) => s.label === 'LinkedIn')!;
const channels = [
  {
    label: 'Email',
    value: profile.email,
    href: `mailto:${profile.email}?subject=Hi%20Bregsi%20%E2%80%94%20let's%20work%20together`,
    icon: 'bx:envelope',
    note: 'Best for project details',
  },
  {
    label: 'WhatsApp',
    value: profile.phoneDisplay,
    href: profile.whatsapp,
    icon: 'bx:bxl-whatsapp',
    note: 'Quick questions',
  },
  {
    label: 'LinkedIn',
    value: 'in/bregsiaju',
    href: linkedin.href,
    icon: linkedin.icon,
    note: 'Professional network',
  },
];
---

<section id="contact" class="contact section-bg">
  <div class="container">
    <SectionTitle eyebrow="Contact" title="Let’s work together">
      Have a project, a role, or a system that needs a reliable back end? I’d love to hear about it.
    </SectionTitle>

    <div class="channels">
      {
        channels.map((c, i) => (
          <a
            class="channel"
            href={c.href}
            target={c.href.startsWith('mailto') ? undefined : '_blank'}
            rel="noopener"
            data-reveal
            style={`--reveal-delay: ${i * 0.08}s`}
          >
            <span class="icon">
              <Icon name={c.icon} aria-hidden="true" />
            </span>
            <span class="label">{c.label}</span>
            <span class="value">{c.value}</span>
            <span class="note">{c.note}</span>
          </a>
        ))
      }
    </div>

    <div class="bottom" data-reveal>
      <p class="loc">
        <Icon name="bx:map" aria-hidden="true" />
        {profile.location} (GMT+7)
      </p>
      <a href={profile.cvUrl} class="btn btn-outline" download>
        <Icon name="bx:download" aria-hidden="true" /> Download CV
      </a>
    </div>
  </div>
</section>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px;
    max-width: 920px;
    margin: 0 auto;
  }

  .channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 30px 20px 26px;
    background: var(--c-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    color: var(--c-text);
    transition:
      box-shadow 0.3s,
      transform 0.3s var(--ease);
  }

  .channel:hover {
    color: var(--c-text);
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .icon {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-primary-soft);
    color: var(--c-primary);
    margin-bottom: 14px;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .channel:hover .icon {
    background: var(--c-primary);
    color: #fff;
  }

  .icon svg {
    width: 26px;
    height: 26px;
  }

  .label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--c-heading);
  }

  .value {
    color: var(--c-primary);
    font-weight: 600;
    word-break: break-word;
    margin: 2px 0;
  }

  .note {
    font-size: 0.85rem;
    color: var(--c-muted);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 28px;
    margin-top: 36px;
  }

  .loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--c-heading);
  }

  .loc svg {
    width: 20px;
    height: 20px;
    color: var(--c-primary);
  }
</style>
