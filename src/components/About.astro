---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionTitle from './SectionTitle.astro';
import photo from '../assets/photos/pp.jpg';
import { about, profile, stats } from '../data/profile';
---

<section id="about" class="about">
  <div class="container">
    <SectionTitle eyebrow="Get to know me" title="About" />

    <div class="about-grid">
      <div class="photo" data-reveal>
        <Image
          src={photo}
          alt={`Portrait of ${profile.name}`}
          widths={[320, 480, 720]}
          sizes="(min-width: 992px) 360px, 70vw"
          loading="lazy"
        />
      </div>

      <div class="content" data-reveal style="--reveal-delay: .1s">
        <h3>{about.heading}</h3>
        {about.paragraphs.map((p) => <p>{p}</p>)}

        <ul class="facts">
          {
            about.facts.map((f) => (
              <li>
                <span class="fact-icon">
                  <Icon name={f.icon} aria-hidden="true" />
                </span>
                <span>
                  <small>{f.label}</small>
                  <strong>{f.value}</strong>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="actions">
          <a href={profile.cvUrl} class="btn btn-primary" download>
            <Icon name="bx:download" aria-hidden="true" /> Download CV
          </a>
          <a href="#contact" class="btn btn-outline">Let’s talk</a>
        </div>
      </div>
    </div>

    <ul class="stats" aria-label="Impact in numbers">
      {
        stats.map((s, i) => (
          <li class="stat" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <span class="stat-icon">
              <Icon name={s.icon} aria-hidden="true" />
            </span>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 992px) {
    .about-grid {
      grid-template-columns: 360px 1fr;
    }
  }

  .photo {
    position: relative;
    width: min(360px, 72vw);
    margin-inline: auto;
  }

  /* Offset frame accent */
  .photo::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 3px solid var(--c-primary);
    border-radius: 50%;
    transform: translate(14px, 10px);
    z-index: -1;
    opacity: 0.35;
  }

  .photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: var(--shadow);
  }

  .content h3 {
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    font-weight: 700;
    color: var(--c-heading);
    margin-bottom: 16px;
  }

  .content p {
    color: #4a5561;
  }

  .facts {
    list-style: none;
    padding: 0;
    margin: 24px 0 28px;
    display: grid;
    gap: 14px;
  }

  @media (min-width: 576px) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .fact-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-primary-soft);
    color: var(--c-primary);
  }

  .fact-icon svg {
    width: 20px;
    height: 20px;
  }

  .facts small {
    display: block;
    font-size: 0.78rem;
    color: var(--c-muted);
    line-height: 1.3;
  }

  .facts strong {
    font-weight: 600;
    color: var(--c-heading);
    font-size: 0.95rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Stats — based on the template's "facts" count boxes */
  .stats {
    list-style: none;
    padding: 0;
    margin: clamp(56px, 7vw, 80px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px 24px;
  }

  .stat {
    position: relative;
    text-align: center;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 40px 20px 24px;
    transition:
      box-shadow 0.3s,
      transform 0.3s var(--ease);
  }

  .stat:hover {
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .stat-icon {
    position: absolute;
    top: -24px;
    left: 50%;
    translate: -50% 0;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-primary);
    color: #fff;
    box-shadow: 0 6px 16px rgba(5, 99, 187, 0.3);
  }

  .stat-icon svg {
    width: 24px;
    height: 24px;
  }

  .stat strong {
    display: block;
    font-family: var(--font-accent);
    font-size: 2.1rem;
    font-weight: 600;
    color: #011426;
    line-height: 1.2;
  }

  .stat span:last-child {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--c-muted);
    margin-top: 4px;
  }
</style>
