---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionTitle from './SectionTitle.astro';
import { skillGroups } from '../data/profile';
---

<section id="skills" class="skills">
  <div class="container">
    <SectionTitle eyebrow="My toolbox" title="Skills">
      Writing code since 2020. These are the tools I’ve used to ship real projects — from payment back ends and
      WhatsApp automation to responsive front ends.
    </SectionTitle>

    <div class="groups">
      {
        skillGroups.map((g, gi) => (
          <div class="group" data-reveal style={`--reveal-delay: ${gi * 0.1}s`}>
            <h3>
              <Icon name={g.icon} aria-hidden="true" />
              {g.title}
            </h3>
            <ul>
              {g.items.map((s) => (
                <li class="skill">
                  {s.logo ? (
                    <Image src={s.logo} alt="" width={40} height={40} loading="lazy" />
                  ) : (
                    <Icon name={s.icon ?? 'bx:code-alt'} class="skill-icon" aria-hidden="true" />
                  )}
                  <span>{s.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 992px) {
    .groups {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .group {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 24px;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--c-border);
  }

  h3 svg {
    width: 22px;
    height: 22px;
    color: var(--c-primary);
  }

  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 10px;
  }

  /* Grayscale logos that come to life on hover — kept from the original design */
  .skill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 14px 6px 12px;
    border-radius: 10px;
    filter: grayscale(100%);
    opacity: 0.85;
    transition:
      filter 0.3s,
      opacity 0.3s,
      background 0.3s,
      transform 0.3s var(--ease);
  }

  .skill:hover {
    filter: none;
    opacity: 1;
    background: var(--c-bg-soft);
    transform: translateY(-3px);
  }

  .skill img,
  .skill-icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .skill-icon {
    color: var(--c-primary);
  }

  .skill span {
    font-family: var(--font-accent);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--c-heading);
    line-height: 1.3;
  }

  @media (hover: none) {
    .skill {
      filter: none;
      opacity: 1;
    }
  }
</style>
