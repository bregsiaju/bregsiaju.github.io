---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { categoryLabels, type Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const href = `/projects/${p.slug}/`;
const shownStack = p.stack.slice(0, 4);
const moreStack = p.stack.length - shownStack.length;
---

<article class="card" data-category={p.category} data-reveal style={`--reveal-delay: ${(index % 3) * 0.08}s`}>
  <a href={href} class="thumb" tabindex="-1" aria-hidden="true">
    {
      p.cover ? (
        <Image
          src={p.cover}
          alt=""
          widths={[400, 640, 800]}
          sizes="(min-width: 1200px) 340px, (min-width: 768px) 45vw, 92vw"
          loading="lazy"
        />
      ) : (
        <span class="placeholder">
          <Icon name={p.icon ?? 'bx:code-alt'} />
          <span>Internal project</span>
        </span>
      )
    }
    <span class="overlay"><span>View details</span></span>
  </a>

  <div class="body">
    <div class="meta">
      <span class="cat">{categoryLabels[p.category]}</span>
      {p.featured && <span class="featured">Featured</span>}
    </div>
    <h3><a href={href}>{p.title}</a></h3>
    <p class="context">{p.context}</p>
    <p class="tagline">{p.tagline}</p>

    <ul class="tags" aria-label="Tech stack">
      {shownStack.map((s) => <li class="tag">{s}</li>)}
      {moreStack > 0 && <li class="tag">+{moreStack}</li>}
    </ul>

    <div class="links">
      <a href={href} class="details">
        View details <Icon name="bx:right-arrow-alt" aria-hidden="true" />
      </a>
      <span class="ext">
        {
          p.links?.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" aria-label={`${p.title} — ${l.label}`} title={l.label}>
              <Icon name={l.icon} aria-hidden="true" />
            </a>
          ))
        }
      </span>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.3s,
      transform 0.3s var(--ease);
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .card[hidden] {
    display: none;
  }

  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(69, 80, 91, 0.8);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s var(--ease);
  }

  .card:hover .thumb img {
    transform: scale(1.05);
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.92);
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.14), transparent 40%),
      linear-gradient(135deg, #0563bb, #45505b);
    font-family: var(--font-accent);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .placeholder svg {
    width: 56px;
    height: 56px;
  }

  /* Corner-bracket hover overlay from the original portfolio grid */
  .overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.75);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .overlay::before,
  .overlay::after {
    content: '';
    position: absolute;
    width: 44px;
    height: 44px;
    transition: all 0.45s var(--ease);
  }

  .overlay::before {
    top: 30px;
    left: 30px;
    border-top: 3px solid var(--c-primary);
    border-left: 3px solid var(--c-primary);
  }

  .overlay::after {
    bottom: 30px;
    right: 30px;
    border-bottom: 3px solid var(--c-primary);
    border-right: 3px solid var(--c-primary);
  }

  .overlay span {
    font-family: var(--font-accent);
    font-weight: 600;
    color: var(--c-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
  }

  .thumb:hover .overlay {
    opacity: 1;
  }

  .thumb:hover .overlay::before {
    top: 14px;
    left: 14px;
  }

  .thumb:hover .overlay::after {
    bottom: 14px;
    right: 14px;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 18px;
  }

  .meta {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
  }

  .cat,
  .featured {
    font-family: var(--font-accent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
  }

  .cat {
    color: var(--c-primary);
    background: var(--c-primary-soft);
  }

  .featured {
    color: #8a5a00;
    background: #fff4dc;
  }

  h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 2px;
  }

  h3 a {
    color: var(--c-heading);
  }

  h3 a:hover {
    color: var(--c-primary);
  }

  .context {
    font-size: 0.8rem;
    color: var(--c-muted);
    margin-bottom: 10px;
  }

  .tagline {
    font-size: 0.92rem;
    color: #4a5561;
    margin-bottom: 16px;
  }

  .tags {
    margin-top: auto;
  }

  .links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--c-border);
  }

  .details {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-accent);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .details svg {
    width: 18px;
    height: 18px;
    transition: transform 0.25s var(--ease);
  }

  .details:hover svg {
    transform: translateX(4px);
  }

  .ext {
    display: flex;
    gap: 2px;
  }

  .ext a {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--c-heading);
    transition:
      background 0.25s,
      color 0.25s;
  }

  .ext a:hover {
    background: var(--c-primary-soft);
    color: var(--c-primary);
  }

  .ext svg {
    width: 20px;
    height: 20px;
  }
</style>
