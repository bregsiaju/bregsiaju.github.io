---
import { Icon } from 'astro-icon/components';
import SectionTitle from './SectionTitle.astro';
import { experience, education, profile, type TimelineItem } from '../data/profile';

const columns: { title: string; icon: string; items: TimelineItem[] }[] = [
  { title: 'Experience', icon: 'bx:briefcase', items: experience },
  { title: 'Education', icon: 'bx:book-open', items: education },
];
---

<section id="resume" class="resume section-bg">
  <div class="container">
    <SectionTitle eyebrow="My journey" title="Resume">
      Production work, freelance projects, internships, and a bootcamp along the way — always learning fast and
      shipping reliable features.
    </SectionTitle>

    <div class="cols">
      {
        columns.map((col) => (
          <div>
            <h3 class="col-title">
              <Icon name={col.icon} aria-hidden="true" />
              {col.title}
            </h3>
            <ol class="timeline">
              {col.items.map((item) => (
                <li class="item" data-reveal>
                  <h4>{item.title}</h4>
                  <p class="org">{item.org}</p>
                  <span class="period">{item.period}</span>
                  <ul>
                    {item.points.map((pt) => (
                      <li set:html={pt} />
                    ))}
                  </ul>
                  {item.tech && (
                    <p class="tech">
                      <strong>Tech:</strong> {item.tech}
                    </p>
                  )}
                  {item.link && (
                    <a class="item-link" href={item.link.href} target="_blank" rel="noopener">
                      {item.link.label} <Icon name="bx:link-external" aria-hidden="true" />
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <div class="cv-banner" data-reveal>
      <div>
        <strong>Want the full picture?</strong>
        <span>Grab a one-page PDF version of my resume.</span>
      </div>
      <a href={profile.cvUrl} class="btn btn-primary" download>
        <Icon name="bx:download" aria-hidden="true" /> Download CV
      </a>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 40px 48px;
  }

  @media (min-width: 992px) {
    .cols {
      grid-template-columns: 1.15fr 1fr;
    }
  }

  .col-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .col-title svg {
    width: 26px;
    height: 26px;
    color: var(--c-primary);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Vertical line + ring markers from the original resume section */
  .item {
    position: relative;
    padding: 0 0 28px 26px;
    border-left: 2px solid var(--c-primary);
  }

  .item:last-child {
    padding-bottom: 4px;
  }

  .item::before {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    left: -9px;
    top: 2px;
    background: var(--c-bg-soft);
    border: 2px solid var(--c-primary);
  }

  h4 {
    font-family: var(--font-accent);
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--c-primary);
    line-height: 1.35;
    margin-bottom: 2px;
  }

  .org {
    font-style: italic;
    color: var(--c-heading);
    margin-bottom: 8px;
  }

  .period {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    background: #e9edf1;
    color: var(--c-heading);
    padding: 3px 12px;
    border-radius: 6px;
    margin-bottom: 10px;
  }

  .item ul {
    padding-left: 18px;
    margin-bottom: 8px;
  }

  .item ul li {
    padding-bottom: 6px;
    color: #4a5561;
  }

  .tech {
    font-size: 0.88rem;
    color: var(--c-muted);
    margin: 0;
  }

  .item-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .item-link svg {
    width: 16px;
    height: 16px;
  }

  .cv-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 48px;
    padding: 24px 28px;
    border-radius: var(--radius);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-left: 4px solid var(--c-primary);
  }

  .cv-banner strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--c-heading);
  }

  .cv-banner span {
    color: var(--c-muted);
  }
</style>
