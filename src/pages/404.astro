---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Bregsi AJ" home={false}>
  <section class="nf">
    <div class="container">
      <p class="code">404</p>
      <h1>This page wandered off.</h1>
      <p>The link may be outdated — the portfolio was recently rebuilt.</p>
      <a href="/" class="btn btn-primary">Back to homepage</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .code {
    font-family: var(--font-accent);
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 600;
    color: var(--c-primary);
    line-height: 1;
    margin: 0;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  p {
    color: var(--c-muted);
    margin-bottom: 24px;
  }
</style>
